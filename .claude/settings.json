{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/claude-pre-commit-check.sh",
            "if": "Bash(git commit*)",
            "timeout": 90,
            "statusMessage": "Compile check..."
          }
        ]
      }
    ]
  }
}
